<?xml version="1.0" encoding="utf-8"?>

<Project DefaultTargets="Build">

  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />

  <PropertyGroup>
    <Name>LithoManager.Database</Name>
    <ProjectGuid>{1dd9baf3-2edb-4eb2-aec1-9bd49df2f7a5}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>

  <ItemGroup>
    <Build Remove="Seeds\**\*.sql" />
    <None Include="Seeds\**\*.sql" />

    <Build Remove="Scripts\Manual\**\*.sql" />
    <None Include="Scripts\Manual\**\*.sql" />

    <PostDeploy Include="Scripts\PostDeployment.sql" />
  </ItemGroup>

</Project>